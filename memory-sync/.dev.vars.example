# Copy to .dev.vars locally; NEVER commit the actual file.
# Generate a random admin token. Never place real credentials in chat or GitHub.
ADMIN_TOKEN=LOCAL_ONLY_CHANGE_ME
# Optional: Notion integration secret for a Notion page explicitly shared to it.
# NOTION_TOKEN=secret_...
# Optional: Google Cloud OAuth offline access. A drive.file grant alone might not see old files.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...
